{
  "paramSchema": [
    {
      "name": "temperature",
      "label": "Temperature",
      "type": "number",
      "default": 0.7,
      "min": 0,
      "max": 2,
      "hide": {
        "capability": [
          "reasoning"
        ]
      },
      "description": "Controls randomness of the output (0 = deterministic)."
    },
    {
      "name": "max_completion_tokens",
      "label": "Max Tokens",
      "type": "number",
      "default": 4096,
      "min": 1,
      "description": "Maximum number of tokens to generate.",
      "show": {
        "capability": [
          "reasoning"
        ]
      }
    },
    {
      "name": "max_tokens",
      "label": "Max Tokens",
      "type": "number",
      "default": 4096,
      "min": 1,
      "description": "Maximum number of tokens to generate.",
      "hide": {
        "capability": [
          "reasoning"
        ]
      }
    },
    {
      "name": "top_p",
      "label": "Top P",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "advanced": true,
      "hide": {
        "capability": [
          "reasoning"
        ]
      },
      "description": "Nucleus sampling cutoff. 1 disables nucleus sampling."
    },
    {
      "name": "frequency_penalty",
      "label": "Frequency Penalty",
      "type": "number",
      "default": 0,
      "min": -2,
      "max": 2,
      "advanced": true,
      "hide": {
        "capability": [
          "reasoning"
        ]
      },
      "description": "Reduces repetition of frequent tokens."
    },
    {
      "name": "presence_penalty",
      "label": "Presence Penalty",
      "type": "number",
      "default": 0,
      "min": -2,
      "max": 2,
      "advanced": true,
      "hide": {
        "capability": [
          "reasoning"
        ]
      },
      "description": "Encourages exploring new topics."
    },
    {
      "name": "reasoning_effort",
      "label": "Reasoning Effort",
      "type": "select",
      "default": "off",
      "options": [
        {
          "label": "Off",
          "value": "off"
        },
        {
          "label": "None",
          "value": "none",
          "show": {
            "capability": [
              "reasoning_effort_none"
            ]
          }
        },
        {
          "label": "Minimal",
          "value": "minimal",
          "show": {
            "capability": [
              "reasoning_effort_minimal"
            ]
          }
        },
        {
          "label": "Low",
          "value": "low"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "High",
          "value": "high"
        },
        {
          "label": "X-High",
          "value": "xhigh",
          "show": {
            "capability": [
              "reasoning_effort_xhigh"
            ]
          }
        },
        {
          "label": "Max",
          "value": "max",
          "show": {
            "capability": [
              "reasoning_effort_max"
            ]
          }
        }
      ],
      "show": {
        "capability": [
          "reasoning"
        ]
      },
      "description": "How much computation the reasoning model spends."
    },
    {
      "name": "response_format",
      "label": "Response Format",
      "type": "select",
      "default": "text",
      "options": [
        {
          "label": "Text",
          "value": "text"
        },
        {
          "label": "JSON object",
          "value": "json_object"
        }
      ],
      "description": "Force the model to return plain text or JSON."
    }
  ],
